{
  "expo": {
    "name": "SolanaLens Mobile",
    "slug": "solana-lens-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/solanalens-icon.png",
    "scheme": "solana-lens-mobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.solanalens.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/solanalens-icon.png",
        "backgroundColor": "#0B0D13"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
